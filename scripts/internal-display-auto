#!/usr/bin/env bash
# Disable the internal laptop panel whenever an external display (HDMI/DP) is
# connected.
#
# Re-enabling on unplug is NOT handled here: Omarchy's own
# omarchy-hyprland-monitor-watch runs `omarchy hyprland monitor internal recover`
# on every monitor event, which clears the toggle once no external is active.
# This script only supplies the missing half -- auto-disabling on plug-in.
#
# Driving Hyprland directly with `hyprctl eval` does not work: that same watcher
# issues `hyprctl reload` and reconciles state every couple of seconds, undoing
# any monitor change made outside the toggle mechanism.
#
# Started from ~/.config/hypr/autostart.lua. Run by hand with:
#   ~/.config/hypr/scripts/internal-display-auto apply

set -uo pipefail

LOG="$HOME/.local/state/internal-display-auto.log"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

apply() {
  if omarchy hyprland monitor external active; then
    log "external active -> disabling internal: $(omarchy hyprland monitor internal off 2>&1)"
  else
    log "no external active -> leaving internal to omarchy recover"
  fi
}

if [ "${1:-}" = "apply" ]; then
  apply
  exit 0
fi

log "daemon start (pid $$)"
apply

socket="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
socat -U - "UNIX-CONNECT:$socket" | while read -r line; do
  case "$line" in
    monitoradded*)
      log "event: $line"
      # Let Omarchy's watcher finish its own reload/reconcile pass first.
      sleep 3
      apply
      ;;
  esac
done
